{
  "expo": {
    "name": "VetNow Kärnten",
    "slug": "vetnow-kaernten",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4f7f6",
    "primaryColor": "#0c7d72",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "at.vetnow.kaernten",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "VetNow verbindet sich im WLAN mit dem VetNow Hub, damit Praxis-Status und Anfragen auf allen Geräten gleich sind."
      }
    },
    "android": {
      "package": "at.vetnow.kaernten",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0c7d72",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Erlauben Sie VetNow Kärnten den Zugriff auf Ihre Fotos, um Bilder an Nachrichten anzuhängen.",
          "cameraPermission": "Erlauben Sie VetNow Kärnten den Zugriff auf die Kamera, um Fotos für Nachrichten aufzunehmen."
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a24f0f8b-5c86-4cc3-b10a-42785275b6c9"
      }
    },
    "owner": "lightningbasti",
    "scheme": "vetnow"
  }
}
