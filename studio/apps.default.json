{
  "groups": [
    { "id": "vetnow", "name": "VetNow Kärnten", "color": "#0f9b8e", "icon": "🐾", "description": "Notfall-Tierarzt-Finder — Web, iPhone & Extension" },
    { "id": "avocado", "name": "Avocado at Law", "color": "#58CC02", "icon": "🥑", "description": "Duolingo für Recht — Web & iPhone" },
    { "id": "ghgflix", "name": "GHGFlix", "color": "#e50914", "icon": "🎬", "description": "Deine eigene Netflix-Alternative — Handy-App, Fernseher & Server-Oberfläche" },
    { "id": "andere", "name": "Weitere Projekte", "color": "#2e6f9e", "icon": "🗂️", "description": "Eigene Apps hinzufügen (auch aus fremden Git-Repos)" }
  ],
  "apps": [
    {
      "id": "avocado-web",
      "name": "Web-App",
      "group": "avocado",
      "color": "#58CC02",
      "icon": "🥑",
      "kind": "web",
      "webDir": "avocado/web",
      "distDir": "dist",
      "basePath": "/avocado/",
      "buildCmd": "mkdir -p dist && cp index.html styles.css *.jsx dist/"
    },
    {
      "id": "avocado-mobile",
      "name": "iPhone-App (Expo Go)",
      "group": "avocado",
      "color": "#2F7D4F",
      "icon": "📱",
      "kind": "expo",
      "expoDir": "avocado/mobile",
      "expoSdk": "54",
      "expoPort": 8083,
      "env": {}
    },
    {
      "id": "vetnow-web-clean",
      "name": "Web-App (sauber)",
      "group": "vetnow",
      "color": "#0f9b8e",
      "icon": "🐾",
      "kind": "web",
      "webDir": "web",
      "distDir": "dist",
      "basePath": "/vetnow/",
      "buildCmd": "npm ci && VITE_VN_CLEAN=true npm run build"
    },
    {
      "id": "vetnow-web-demo",
      "name": "Web-App (Demo + Bot)",
      "group": "vetnow",
      "color": "#19b3a4",
      "icon": "🧪",
      "kind": "web",
      "webDir": "web",
      "distDir": "dist-demo",
      "basePath": "/vetnow-demo/",
      "buildCmd": "npm ci && npx vite build --base=/vetnow-demo/ --outDir dist-demo"
    },
    {
      "id": "vetnow-mobile-clean",
      "name": "iPhone-App (sauber)",
      "group": "vetnow",
      "color": "#0c7d72",
      "icon": "📱",
      "kind": "expo",
      "expoDir": "mobile",
      "expoSdk": "54",
      "expoPort": 8081,
      "env": { "EXPO_PUBLIC_VN_CLEAN": "true" }
    },
    {
      "id": "vetnow-mobile-demo",
      "name": "iPhone-App (Demo + Bot)",
      "group": "vetnow",
      "color": "#2e6f9e",
      "icon": "🧫",
      "kind": "expo",
      "expoDir": "mobile",
      "expoSdk": "54",
      "expoPort": 8082,
      "env": {}
    },
    {
      "id": "vetnow-extension",
      "name": "Chrome-Extension",
      "group": "vetnow",
      "color": "#8a5d05",
      "icon": "🧩",
      "kind": "extension",
      "extensionDir": "extension"
    },

    {
      "_kommentar": "GHGFlix liegt in einem EIGENEN Repo — das Studio klont es beim ersten Start automatisch nach /data/ext-repos/ghgflix-mobile.",
      "id": "ghgflix-mobile",
      "name": "Handy-/TV-App (Expo Go)",
      "group": "ghgflix",
      "color": "#e50914",
      "icon": "📱",
      "kind": "expo",
      "repoUrl": "https://github.com/BastiLd/GHGFLIX.git",
      "repoBranch": "feature/zimaos-docker-server",
      "expoDir": "mobile",
      "expoSdk": "54",
      "expoPort": 8044,
      "env": {}
    },
    {
      "_kommentar": "Kleine Karte, die auf den laufenden GHGFlix-Container (Port 8484) verlinkt — inkl. Installationsseite und Fernseh-Modus.",
      "id": "ghgflix-open",
      "name": "Server-Oberfläche öffnen",
      "group": "ghgflix",
      "color": "#ff2b36",
      "icon": "🎬",
      "kind": "web",
      "repoUrl": "https://github.com/BastiLd/GHGFLIX.git",
      "repoBranch": "feature/zimaos-docker-server",
      "webDir": "server/studio-card",
      "distDir": "dist",
      "basePath": "/ghgflix/",
      "buildCmd": "mkdir -p dist && cp index.html dist/"
    }
  ]
